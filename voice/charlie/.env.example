# Charlie 语音助手 — 环境变量配置
# 复制此文件为 .env，填入你自己的 API 密钥
# 未配置的项会自动降级或禁用，不会导致启动失败
# 也可启动后访问 http://localhost:8000/setup 用网页填写

# ===== 核心（必需，缺这些会降级运行） =====

# 百度智能云 (ASR 语音识别 / TTS 语音合成) — https://console.bce.baidu.com/ai/#/ai/speech/overview/index
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 高德地图 (天气查询) — https://console.amap.com
AMAP_KEY=

# ===== 智谱 GLM LLM（永久免费备选）=====
# OpenAI 兼容，thinking 可禁用（低延迟）。永久免费。
# 获取 Key: https://open.bigmodel.cn/apikey/platform
GLM_KEY=
GLM_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7-flash
# GLM 429 限流 fallback 链（逗号分隔，按顺序轮换）
GLM_MODELS=glm-4.7-flash,glm-4-flash,glm-4.5-flash

# ===== 火山引擎 ARK LLM（备选）=====
# 获取 Key: https://console.volcengine.com/ark
ARK_KEY=
ARK_BASE=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest

# ===== Agnes LLM 大脑（推荐首选）=====
# OpenAI 兼容，thinking 可禁用（低延迟）。免费 Key 注册即送。
AGNES_KEY=
AGNES_BASE=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
# Agnes 新加坡节点（备用）
SAGNES_KEY=
SAGNES_BASE=https://api-sg.agnes-ai.com/v1
SAGNES_MODEL=agnes-2.0-flash

# ===== 闲聊快通道（lite）超时参数（agent/llm.py::_chat_lite_stream）=====
# 闲聊/常识问答走快通道：主节点（默认 Agnes，非 reasoning）无产出时切大脑
# provider（stepfun，reasoning）重试一次。两个首包预算之和受端到端首句预算
# （XIAOZHI_FIRST_SENTENCE_TIMEOUT=8s）约束，调大前先算预算账。
LITE_FIRST_CONTENT_TIMEOUT=3.0  # 代码默认: 3.0s（主节点首 content 最大等待）
LITE_FALLBACK_FIRST_CONTENT_TIMEOUT=5.0  # 代码默认: 5.0s（备用是 reasoning 模型，思维链慢）
LITE_FALLBACK_MAX_TOKENS=512  # 代码默认: 512（备用思维链与正文共享预算，300 会零正文）
LITE_MAX_TOKENS=300  # 代码默认: 300（主节点非 reasoning，正文预算）
LITE_TOTAL_TIMEOUT=12  # 代码默认: 12s（单次流式总时长硬上限）
# LITE_PROVIDER=  # 代码默认: 空（= Agnes 优先）。可选强制闲聊走指定 provider；
#                 ⚠️ 只能用非 reasoning 的 provider，指到 stepfun 每句都更慢
#                 （思维链先跑完才吐字）且有一类输入 100% 零正文

# ===== StepFun LLM + ASR + TTS 降级备选 =====
# 注意: StepFun LLM 的 reasoning（思考链）无法禁用，会消耗 max_tokens，
# 延迟比 Agnes 高（~2.3s vs ~1s）。建议作为最后降级使用。
# ASR (stepaudio-2.5-asr) 兼容 OpenAI /audio/transcriptions，延迟 ~0.8s。
# TTS (stepaudio-2.5-tts + 系统预设音色) 兼容 OpenAI /audio/speech，流式首块 ~0.55s。
#   系统音色列表: curl -H "Authorization: Bearer $STEPFUN_KEY" \
#     "https://api.stepfun.com/v1/audio/system_voices?model=step-tts-2"
#   常用音色: cixingnansheng(磁性男声) jingdiannvsheng(经典女声) boyinnansheng(播音男声)
# 获取 Key: https://platform.stepfun.com
# 多 Key 轮询：逗号分隔多把（STEPFUN_KEY=sk-a,sk-b,sk-c,...），全部 StepFun
# 调用（TTS/ASR/LLM/realtime）共用一个本地轮询路由：每次请求换下一把，
# 429 自动冷却 60s（STEPFUN_KEY_COOLDOWN 可调）换下一把，401/403 隔离 30 分钟。
# 单把 key 写法行为不变。
STEPFUN_KEY=
STEPFUN_LLM_BASE=https://api.stepfun.com/step_plan/v1
STEPFUN_LLM_MODEL=step-3.5-flash-2603
# 意图分类专用端点：每句话热路径最前的一次调用，只要一个词。与主对话
# （STEPFUN_LLM_MODEL 的 step-5-preview 等 reasoning 模型）解耦——思维链
# 共享 max_tokens 会把一次分类拖到 10s+。key 留空则复用上面的 STEPFUN_KEY
# 多 key 轮询；解析不到 key 时自动回落到主对话端点。
INTENT_CLASSIFIER_BASE=https://api.stepfun.com/step_plan/v1
INTENT_CLASSIFIER_MODEL=step-3.7-flash
INTENT_CLASSIFIER_KEY=
STEPFUN_ASR_BASE=https://api.stepfun.com/v1
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
# TTS 走订阅路径 step_plan/v1（与 LLM 同一条计费通道）：这个路径下只有
# stepaudio-2.5-tts。step-tts-2 属于 v1 路径，base 与 model 必须成对改，
# 混用会 404。
STEPFUN_TTS_BASE=https://api.stepfun.com/step_plan/v1
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=cixingnansheng

# LLM 优先级链（逗号分隔，按顺序降级）
LLM_PRIORITY=stepfun,agnes,sagnes,glm,ark

# ===== 本地 ASR（竞速首选，实测比云端快 5 倍+） =====
# SenseVoice 本地 ASR (实测 32-73ms vs 百度 151-352ms，无网络往返)
# 准确率实测 (say 合成 10 句干净音频): 平均 CER 3.3%，语义 10/10 全对；
# live 闭环 7 轮识别 100% 正确（"详细介绍一下"→"详细介绍以下" 为同音字错误、
# "九点四十五分"→"9点45分" 为 use_itn 数字转换，均不影响下游意图）
# 竞速策略: 本地干净时不等云端（StepFun 800ms+ 赶不上 50ms 宽限），本地优先；
# 本地乱码/为空时回退云端（等满 1.2s deadline）
# 注意: sherpa_onnx 只装在 .venv（python3.12），服务必须从 .venv 启动，
# 否则本地 ASR 不可用、静默回退百度（日志无 SenseVoice 加载即为征兆）
# 模型下载: https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2025-09-09.tar.bz2
# 解压到 models/sense-voice/ (含 model.int8.onnx + tokens.txt)
# 或运行: bash scripts/download-models.sh
SENSE_VOICE_MODEL=models/sense-voice
SENSE_VOICE_DISABLED=0

# ===== 本地唤醒词检测（可选，需 sherpa-onnx KeywordSpotter）=====
# KWS_MODEL: sherpa-onnx 关键词检测模型目录（需包含 encoder.onnx / decoder.onnx / joiner.onnx / tokens.txt）
# 也可将 KWS_MODEL 设为模型文件路径，tokens/keywords 会自动补齐或通过下方变量指定。
KWS_MODEL=
# KWS_TOKENS: tokens.txt 路径（留空则从 KWS_MODEL 目录自动查找）
KWS_TOKENS=
# KWS_KEYWORDS: keywords.txt 路径（留空则从 KWS_MODEL 目录自动查找；也可放在项目 keywords/ 目录下）
KWS_KEYWORDS=
# 预置唤醒词文件放在项目根 keywords/ 目录，启动时自动加载（不设置 KWS_MODEL 时仍可启用 openWakeWord）
# 示例: keywords/ 下放置 my_wake.txt（每行一个词或短语）

# ===== 飞书（消息推送 / 文档 / 日历） =====
# https://open.feishu.cn — 创建自建应用获取 App ID/Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书推送目标用户 open_id (ou_xxx)，在「通讯录」找到用户查看
FEISHU_PUSH_OPEN_ID=
# 0=禁用飞书主动推送（天气/热点/提醒）
FEISHU_PUSH_ENABLED=1
# 飞书机器人 Webhook (watchdog 异常告警用，可选)
FEISHU_WEBHOOK=
# 飞书事件订阅 Verification Token（开发者后台 → 事件订阅页面获取）
# 配置后 /api/feishu/webhook 可接收用户消息，实现双向对话
FEISHU_VERIFICATION_TOKEN=
# 开发模式：允许 LLM 通过飞书对话修改项目文件（需同时设置 MCP_PROFILE=all）
DEV_MODE_ENABLED=
# 允许开发操作的飞书用户 open_id（逗号分隔，留空=所有飞书用户可操作）
FEISHU_DEV_OPEN_IDS=

# ===== ntfy 备用通知通道 =====
# 自托管 ntfy 地址或 https://ntfy.sh，不填则不推送
NTFY_URL=
# ntfy topic（填了才启用，如 charlie-alerts）
NTFY_TOPIC=
# 认证 "user:pass"（可选）
NTFY_AUTH=

# ===== 涂鸦红外空调控制 =====
# 空调若为涂鸦万能红外遥控器(category=qt), 2C 终端用户 API (TUYA_API_KEY 的 sk- Bearer key)
# 的 shadow/properties/issue 只更新影子不触发红外发码, 必须用 2B 开发者红外云 API。
# 凭证: iot.tuya.com -> 云开发 -> 你的云项目 -> 获取授权
TUYA_CLIENT_ID=
TUYA_ACCESS_KEY=
# 2C 终端用户 API Key (Bearer，读设备状态用)
TUYA_API_KEY=
# 红外网关设备 ID (即空调遥控器 device id, 与 TUYA_AC_DEVICE_ID 同一个)
TUYA_IR_DEVICE_ID=
# 空调设备 ID
TUYA_AC_DEVICE_ID=
# 验证: python tuya_ir_verify.py status (只读) / on / off
TUYA_BASE_URL=https://openapi.tuyacn.com

# ===== ESP32 开发板终端 =====
# ESP32 局域网 IP (缺失则 ESP32 相关功能不可用)
ESP32_IP=
# OTA 返回给 ESP32 的服务器 IP (默认空=自动探测 LAN IP; 用 IP 别名时显式指定)
ESP32_OTA_IP=

# ===== MQTT 信令通道（ESP32 主动推送）=====
# 决策引擎触发推送时，ESP32 不在线 → MQTT wake 摇醒 → ESP32 主动建 WS → flush TTS
# broker: 本地 mosquitto / 公网 broker.emqx.io / 自建 docker
# ESP32 固件订阅 charlie/esp32/{device_id}/wake
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_DEVICE_ID=esp32-default
# 1=OTA 响应中返回 mqtt 段（激活固件 MqttProtocol；当前固件 MQTT 不 subscribe，
# 服务器推送无法到达 idle 的 ESP32，默认关闭，ESP32 走 WebSocketProtocol）
MQTT_ENABLE_OTA=0
# 1=OTA 响应下发 firmware 段，ESP32 开机自己拉固件升级。本机 USB 是原生
# USB-JTAG（无桥片），串口拉不进下载模式，所以这是唯一的烧录通道。
# 版本号必须高于设备当前版本才装，装完版本一致就不再升，不会反复重刷。
XIAOZHI_OTA_FIRMWARE_ENABLE=0
XIAOZHI_OTA_FIRMWARE_VERSION=2.2.0
XIAOZHI_OTA_FIRMWARE_FILE=xiaozhi-lc-s3-2.2.0.bin
# 1=OTA 响应下发 device 段，把设备级默认参数（如 auto_listen 免唤醒自动开麦）
# 告诉设备。固件写进自己的 NVS，改参数不用重刷固件，重启取一次配置即生效。
# 具体值在设置页 http://<本机IP>:8000/settings 改，这里只是总开关。
XIAOZHI_OTA_DEVICE_ENABLE=1

# ===== 搜索与购物分析 =====
# Tavily 搜索 (免费 1000 次/月) — https://tavily.com
TAVILY_API_KEY=
# 阿里云 DashScope (购物分析/翻译) — https://dashscope.aliyun.com
ALIYUN_API_KEY=

# ===== 个性化热点推送 =====
# 推送间隔秒数 (默认 1 小时)
PERSONALIZED_PUSH_INTERVAL=3600
# 默认城市 (天气/穿搭推荐)
DEFAULT_CITY=北京
# 推送静音时段（避免夜间打扰）
PERSONALIZED_PUSH_QUIET_START=22
PERSONALIZED_PUSH_QUIET_END=7

# ===== 运行时系统配置 =====
# 访问鉴权 Token (设置后非 localhost 直连请求需携带 Bearer 此值;
# 公网隧道/反代部署强烈建议设置。可执行: openssl rand -hex 16 生成)
AUTH_TOKEN=
# 内部跨进程推送鉴权 Token (HTTP/HTTPS 分离部署时用于 /api/internal/* 端点;
# 留空则仅允许本机访问内部端点)
INTERNAL_API_TOKEN=
# 1=信任 X-Forwarded-For (反代场景)
ASSISTANT_KID_TRUST_PROXY_HEADERS=0
# HTTP/HTTPS 端口
ASSISTANT_KID_HTTP_PORT=8000
ASSISTANT_KID_HTTPS_PORT=8443
# 额外允许的 CORS 源 (逗号分隔)
ASSISTANT_KID_CORS_ORIGINS=
# 数据/日志目录 (默认项目根)
ASSISTANT_KID_DATA_DIR=  # 数据目录(提醒/历史/建议状态); 留空=项目根, 或指定绝对路径
ASSISTANT_KID_LOG_DIR=
LOG_FILE_DISABLE=  # 1=禁用文件日志(HTTPS进程自动设置,防双进程同写app.log)
# ===== 日志（详见 docs/LOGGING.md）=====
LOG_LEVEL=  # 全局级别，默认 INFO
# 按模块覆盖，逗号分隔 名称=级别，支持点分层次继承
# 排查 ESP32 连接问题: LOG_LEVELS="app.xiaozhi_ws=DEBUG"
LOG_LEVELS=
LOG_CONSOLE_LEVEL=  # 控制台级别，默认跟随 LOG_LEVEL（文件仍按 LOG_LEVEL）
LOG_MAX_BYTES=  # 单文件上限，默认 5000000
LOG_BACKUP_COUNT=  # 轮转份数，默认 3
TRACE_STAGES=  # 1=输出所有阶段耗时（默认只在超阈值时输出 WARNING）
TRACE_SLOW_STAGE_MS=  # 阶段耗时超此值升 WARNING，默认 3000
# 多用户 ID (按用户隔离对话历史/偏好)
#
# ⚠️ 这是**进程级兜底**：改了它，所有并发会话一起变身份。多人场景请用下面的
#    CHARLIE_DEVICE_USERS 按设备绑定（FR-14）。
CHARLIE_USER_ID=default
# 设备 → 用户映射（JSON）。让每台 ESP32 用各自的身份，实现按人隔离。
# 也可以在运行期调 POST /api/device-users 绑定，会写到 device_users.json（env 优先）。
# 未绑定的设备使用 CHARLIE_USER_ID，行为与改造前完全一致。
# 例（三台设备 / 三个人）：
#   CHARLIE_DEVICE_USERS={"aa:bb:cc:dd:ee:01":"laoyu","aa:bb:cc:dd:ee:02":"jiaren1","living-room":"jiaren2"}
CHARLIE_DEVICE_USERS=
# 1=跳过后台调度器 (HTTPS 进程用, HTTP 进程管理)
SKIP_BACKGROUND=0
# 1=启用自主决策引擎 (早安简报/午饭/久坐/晚安等自动判断)
DECISION_ENGINE_ENABLED=1
# 系统提示词缓存 TTL（秒），角色/偏好变更后需等待此时间才生效
SYSTEM_MSG_TTL=300
# MCP 启用模式: core (默认 12 个核心) / all (19 个) / custom (读 MCP_SERVERS)
MCP_PROFILE=core
# 自定义 MCP 列表 (逗号分隔, 仅 MCP_PROFILE=custom 时生效)
MCP_SERVERS=

# ASR 优先级链（逗号分隔，按顺序降级）
ASR_PRIORITY=sensevoice,baidu,stepfun,vosk
# TTS 优先级链（逗号分隔，按顺序降级）
# 2026-09 起默认只走 stepfun（step_plan 路径 stepaudio-2.5-tts），云端不再用百度/Finna。
# 可选 provider: stepfun, edge (edge-tts 免费微软语音，需 pip install edge-tts),
#                audio8 (本地 ONNX 零样本克隆), cosyvoice (CosyVoice 语音克隆，见下方配置);
#                baidu/finna 代码保留兼容但不推荐
TTS_PRIORITY=stepfun
# 全云端 TTS 挂掉时的 macOS say 兜底音色（音色名见 `say -v '?'`）
# ⚠️ 不指定时 say 用系统默认音（Siri 类，读中文没有音色、像念字）；
#    Tingting 是 zh_CN 标准音。Linux/容器上音色不存在会自动退裸 say。
OFFLINE_TTS_VOICE=Tingting

# ===== Decider-2B 本地意图决策头（可选，默认关闭）=====
# 本地 "问题+选项→概率" 决策头（MLX 8bit，1.9GB，进程常驻 ~4.6GB）。
# 开启后意图分类先走它（~250ms，实测 25/28 全对 0 错判），弃权/服务挂了自动
# 落回关键词+LLM 分类。需先启动: python3 /Users/sxliuyu/models/decide_server.py 8080
DECIDE_ENABLED=0
DECIDE_BASE=http://127.0.0.1:8080
DECIDE_INTENT_ABSTAIN=0.5
# 意图路由后端：http（默认，调 Decider-2B 服务）/ la（Laya 多语决策模型）。
# backend=laya 时由 Laya 端侧决策头做中文意图路由（不依赖外部服务；设
# DECIDE_LAYA_URL=0 强制进程内加载，其余值填常驻服务 http://host:port）。
DECIDE_BACKEND=http
DECIDE_LAYA_URL=0
# Laya 常驻决策服务（scripts/laya_service.py）地址；默认 host=127.0.0.1 port=8091。
DECIDE_HOST=127.0.0.1
DECIDE_PORT=8091
# Laya + Needle3 工具快路径（默认关闭）：开启后中文只读/可逆工具意图在 LLM 之前
# 由端侧双引擎直接解析并执行 charlie 真实工具，省一次云端 fncall 循环。写操作
# 默认只规划不执行（落回 LLM）。实验特性，不进生产路径。
LAYA_TOOL_ENABLED=0

# ===== 用户画像（agent/user_profile.py，聚合门面，默认全关）=====
# 把散在各处的用户状态（偏好/喜好/位置/显式回复风格/对话背景）聚合成一个统一
# 画像对象 get_user_profile()，只读不改行为；逐级灰度、可单独回滚。
# P1 只读聚合 + 审计日志（brain 里观测画像覆盖率/质量，零行为变更）
USER_PROFILE_ENABLED=0
# P3 自动沉淀：每轮对话后台抽取事实入库（复用记忆抽取），落库前过敏感信息过滤
USER_PROFILE_AUTOSTORE=0
# P4 注入：把稳定画像字段（位置/喜好/偏好/显式回复风格）拼进 system prompt
USER_PROFILE_INJECT=0

# ===== 多轮指代消解（agent/coreference.py，默认关闭）=====
# 开启后，brain() 在推理前把当前句里的代词/省略/指示词（"它""那个""那首歌""
# 再看一眼院子"）就近还原成字面实体，喂给 Laya 快路径 + LLM，解决跨轮指代。
# 纯函数、无副作用、不落库；关时原句透传、零行为变更。就近消解靠历史，Laya
# 无状态也能接住"把它关了""那首歌再放一遍"。实验特性。
MULTITURN_COREF_ENABLED=0

# ===== 开放任务 agent CLI（magic-agent，可选，默认开）=====
# 固定工具域覆盖不了的开放任务（"清理磁盘""排查网络""备份归档"）派发给 agent CLI
# 后台执行：语音侧秒回一句确认，任务完成结果经飞书推送（FEISHU_PUSH_ENABLED=1 时）。
# CLI 需在 PATH 中（hermes ~/.local/bin / opencode,pi: homebrew）。CLI 不可用时
# 开放任务自动回退大脑通用工具回答，行为与接入前一致。
AGENT_CLI_ENABLED=1
AGENT_CLI_BIN=hermes
# hermes agent 循环软预算（秒），到点 hermes 自行收尾
AGENT_CLI_RUN_BUDGET=600
# 本模块硬超时（秒，>run-budget），到点 kill 整个进程组（含工具子进程）
AGENT_CLI_TIMEOUT=900
# hermes --max-turns：多步任务上限
AGENT_CLI_MAX_TURNS=12
# hermes --in 工作目录（空=用进程 cwd）
AGENT_CLI_WORKDIR=
# 结果推送截断长度（字符）
AGENT_CLI_PUSH_MAX_CHARS=800

# ===== CosyVoice 语音克隆（可选，把 cosyvoice 加进 TTS_PRIORITY 启用）=====
# 需自建 wrapper 服务，接口约定见 docs/cosyvoice-wrapper.md
COSYVOICE_BASE=http://127.0.0.1:8080
# 默认说话人（未命中克隆声时使用；7 个规范音色映射: 男声→中文男, 女声→中文女）
COSYVOICE_SPEAKER=中文女
# 合成请求超时（秒）
COSYVOICE_TIMEOUT=60

# ===== StepFun Realtime 发声通道（FR-13，可选加速，默认关闭）=====
# 开启后：LLM/动作仍走自有 brain，只有"发声"换成 Realtime 流式合成，
#         端到端首音频 ~600ms（现链路 stepaudio-2.5-tts ~1733ms）。取消边界只画在"发声"。
#         模型/路径与上面的 TTS 一致，都是订阅路径 step_plan/v1 的正式计费模型。
# ⚠️ stepaudio-2.5-realtime 是计费模型（输出 70 元/1M tokens，非限免），
#    不接受按 token 计费请保持 ENABLED=0
STEPAUDIO3_RT_ENABLED=0
STEPAUDIO3_RT_URL=wss://api.stepfun.com/step_plan/v1/realtime
STEPAUDIO3_RT_MODEL=stepaudio-2.5-realtime
STEPAUDIO3_VOICE=jingdiannvsheng
# ⚠️ 必须与下行设备采样率一致（24k）。改错会让设备变调/变速，且不报任何错
STEPAUDIO3_SAMPLE_RATE=24000
# 让模型"照读"的指令模板（{text} 为占位符）；实测换措辞会被改写并报 error
STEPAUDIO3_READ_INSTRUCTION=请逐字朗读下面这句话，不要改写：{text}

# ===== Agnes 视觉分析调参（视觉主链自动用 AGNES_KEY，此处仅调参，可选）=====
AGNES_VISION_TIMEOUT=30
AGNES_VISION_MAX_TOKENS=1000
AGNES_VISION_TEMPERATURE=0.3

# ===== ASR 竞速择优（质量优先，延迟可控） =====
# 1=启用本地SenseVoice与云端StepFun并行竞速，0=回退串行降级
ASR_RACE=1
# ASR 竞速总deadline(ms)，超过则放弃云端结果
ASR_RACE_DEADLINE_MS=1200
# 本地结果干净时，额外等待云端的宽限期(ms)
ASR_RACE_GRACE_MS=50

# ===== 高级调参（一般无需修改） =====
# 日志格式: text 或 json
LOG_FORMAT=
# Finna TTS (百度 TTS 失败时的降级) — https://www.finna.com.cn
FINNA_API_KEY=
FINNA_BASE=
TTS_VOICE=
TTS_MODEL=
TTS_SPEED=
TTS_CACHE_MAX_CHARS=200
TTS_FAILURE_THRESHOLD=3
TTS_FAILURE_COOLDOWN=120
LOCAL_TTS_ENABLED=0
# ASR 热词表 (逗号分隔)
ASR_HOTWORDS=
# ESP32 VAD 尾静音帧数 (0.06s/帧)
XIAOZHI_VAD_SILENCE_FRAMES=8
XIAOZHI_VAD_THRESHOLD=0.5
# VAD 开关: 1=启用 Silero VAD, 0=强制降级为 RMS 能量检测
XIAOZHI_VAD_ENABLED=1  # 代码默认: 1 (Silero VAD)
# 对话连续窗口秒数（收到有效命令后保持监听的时长；0=禁用断开，保持长连接供主动推送）
XIAOZHI_ARM_WINDOW=120  # 代码默认: 120s（_get_arm_window 非 jarvis 角色）
# jarvis 角色专用对话窗口（jarvis 角色激活时覆盖 XIAOZHI_ARM_WINDOW）
XIAOZHI_JARVIS_ARM_WINDOW=300  # 代码默认: 300s（jarvis 角色）
# 大脑首句死链预算秒数（回复的首句超过该时长未产出即判死链、发兜底话术。
# ⚠️ 这不是"等待用户说话"的时长（那个是 XIAOZHI_ARM_WINDOW）。
# 调大只是让死链判定更晚、用户等更久——死链的真正修法在 lite 超时参数）
XIAOZHI_FIRST_SENTENCE_TIMEOUT=8  # 代码默认: 8.0s（测试钉死 ≤10s）
# 多设备存在检测 (格式: name=手机;mac=aa:bb:cc:dd:ee:ff;ip=192.168.1.100)
KNOWN_DEVICES=
# 本地唤醒词 (逗号分隔)
WAKE_WORDS=
# 意图分类熔断参数
ASSISTANT_KID_INTENT_FAILURE_THRESHOLD=2
ASSISTANT_KID_INTENT_FAILURE_COOLDOWN=5  # 代码默认: 5s（足够防抖动，连续失败暂停本地分类）
# 重试延时上限(秒)
ASSISTANT_KID_RETRY_AFTER_CAP=60

# ===== Ollama (已移除，保留兼容) =====
# 本地 Ollama 兼容变量（当前版本未使用，保留供旧 import/脚本兼容）
OLLAMA_ENABLED=
OLLAMA_HOST=
OLLAMA_MODEL=
# ===== 摄像头(安卓旧手机 IP Webcam / DroidCam) =====
# 手机装 IP Webcam 等App后, 同一WiFi下获取 http://手机IP:8080
# 多个源: CAMERA_SOURCES=门口=http://192.168.1.101:8080,桌面=http://192.168.1.102:8080
# 单个源: CAMERA_URL=http://192.168.1.101:8080（源名 default）
# 留空=摄像头功能关闭（"看看门口"等语音请求回退普通对话）
CAMERA_SOURCES=
CAMERA_URL=
# 抓帧超时(秒) / 帧缓存有效期(秒)
CAMERA_GRAB_TIMEOUT=6
CAMERA_FRAME_TTL=2

# ===== 萤石云摄像头(猫眼/门铃等云设备) =====
# 1. open.ys7.com 注册开发者 → 创建应用 → 获取 AppKey/AppSecret
# 2. 萤石云视频App里查看设备序列号(设备设置→关于)
# 3. 源写法: CAMERA_SOURCES=门口=ezviz://设备序列号
# 注意: App内需关闭该设备的"视频加密"(我的→设置→视频加密)
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
