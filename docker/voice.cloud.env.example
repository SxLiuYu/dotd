# docker/voice.cloud.env.example —— 云主机（2C4G 起）
#
# 一份文件同时给 Charlie 和 dotd 用：one_system 会把 DOTD_* 透传给自己拉起的 daemon。
# 绝不提交包含真实密钥的 .env。

# ── 必填 ────────────────────────────────────────────────────────────
# 主人令牌：Web/CLI/Charlie 共用；用 `openssl rand -hex 32` 生成
DOTD_MASTER_TOKEN=change-me-32-bytes-hex
# 模型：至少一个 OpenAI 兼容端点（见 config/models.yml）；没有 key 就先只跑反射层
HY3_API_KEY=

# ── 模型与执行 ──────────────────────────────────────────────────────
# cloud 档位建议 docker（工具跑独立容器）；没有 docker.sock 就保持 stub
DOTD_FLEET=docker
# 本地场景+记账交给 dotd；设 off 只做语音壳
CHARLIE_CORTEX=auto
DOTD_TIMEOUT=90

# ── 语音 ────────────────────────────────────────────────────────────
# ASR/TTS 供应商 key（Charlie 侧读取；留空则用本地/降级路径）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# ESP32 设备令牌：上公网前必须改掉上游默认值 "device"
XIAOZHI_DEVICE_TOKEN=change-me
TZ=Asia/Shanghai

# ── 可选 ────────────────────────────────────────────────────────────
# 公网入口（Charlie 的 HTTPS/WSS 证书）
CHARLIE_HTTPS_PORT=8443
