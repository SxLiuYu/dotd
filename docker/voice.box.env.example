# docker/voice.box.env.example —— 家里盒子 / 树莓派 4-5 / 迷你主机
#
# 与 cloud 的差异：默认不起 Docker 工具（小盒子跑不动），数字工具降级为
# 宿主 MCP / 只读；反射层与记忆完全可用，断网也能开灯/执行场景。

DOTD_MASTER_TOKEN=change-me-32-bytes-hex
HY3_API_KEY=

# 盒子档位：stub 执行面（无容器），工具只走宿主 MCP
DOTD_FLEET=stub
CHARLIE_CORTEX=auto
DOTD_TIMEOUT=90

BAIDU_API_KEY=
BAIDU_SECRET_KEY=
XIAOZHI_DEVICE_TOKEN=change-me
TZ=Asia/Shanghai
