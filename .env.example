# dotd 环境变量模板（.env.example）
# =====================================================================
#
# ⚠️ 重要：dotd 的代码**不读取 .env 文件**。
#    全仓库 grep `dotenv` 零命中（src/ scripts/ db/ agent-runtime/ tools/ tests/），
#    也没有任何代码 load 本文件。本文件只是"需要哪些变量、去哪拿"的清单，
#    变量必须真正 export 进启动 daemon 的那个 shell。
#
# 推荐流程（bash；原生 Windows 用 Git Bash）：
#     cp .env.example ~/.dotd/tokens.env   # 或直接照抄 scripts/setup-dev-env.sh
#     逐项填值
#     source ~/.dotd/tokens.env && npm run serve
#  （scripts/dev-run.sh 就是 source ~/.dotd/tokens.env 后起 daemon 的）
#
# ⚠️ 覆盖陷阱：本文件全是 __REPLACE_ME___ 占位符，直接
#    `cp .env.example ~/.dotd/tokens.env` 会把真 token 覆盖成占位符，下次启动报
#    ConfigError「环境变量 DOTD_MASTER_TOKEN 未设置」（src/surfaces/config.ts:204-211，
#    未设/空即拒）且看不出是覆盖导致的。已经生成过真 token 的话：照抄本文件内容
#    手动合并进 tokens.env，或者先备份再重新生成。别直接 cp 覆盖。
#    补键用 `node scripts/init-config.mjs`（跨平台，只补缺键不动已有行）或
#    `scripts/setup-dev-env.sh`（WSL，幂等补齐，已有键原样保留）。
#
# ⚠️ 本文件只放占位符，绝不放真实密钥。真实 token 落在 ~/.dotd/tokens.env（不入库）。
#
# 变量分四组：
#   A. 硬性必填（缺任一项 → daemon 直接拒启动，中文 ConfigError 追加进 ~/.dotd/OUTBOX.md）
#   B. 模型层 key（缺了不拒启动，但会在第一次真实调用时把熔断器打开）
#   C. 可选通道 / 运维覆盖（全有默认值，缺省即走默认路径）
#   D. 预留但当前无代码读取（列出来只为说明别白配）

# ── A. 硬性必填 ────────────────────────────────────────────────────
# 这三项对应 config/dotd.yml 的 surfaces 节占位符 ${...}，
# 由 loadSurfacesConfig 展开；展开后为空即抛 ConfigError（fail-closed，
# 空 master token = 任何人都能以主人身份操作 daemon）。
# 读取处：src/surfaces/config.ts:353-366（:354 取路径，:359 读不到文件即拒，
#         :363 master_token 空即拒）。

# HTTP 主 token。CLI / Web UI / API 的 Bearer 凭证，也用于写操作。
# 拿法：自己生成随机 hex，别复用别的服务的 token：
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DOTD_MASTER_TOKEN=__REPLACE_ME_16_BYTES_HEX__

# HTTP 只读 token（GET /api/status、/api/queue 等查询接口可用）。
# 拿法：同上，12 字节 hex 即可。没有只读客户端就填和 MASTER 不同的随机值，
#       不能留空（空串同样 fail-closed）。
DOTD_RO_TOKEN=__REPLACE_ME_12_BYTES_HEX__

# webhook HMAC secret。config/dotd.yml:58 的 hooks[0]（source: grafana）用它签名，
# daemon 侧对 POST /hooks/grafana 验签。换 source 名则改 config.yml 里对应的占位符。
# 拿法：自己生成 12 字节 hex；Grafana 侧通知渠道的 secret 要填同一个值。
HOOK_GRAFANA=__REPLACE_ME_12_BYTES_HEX__

# ── B. 模型层 key（config/models.yml 的 api_key_env）────────────────
# 缺 key 不是启动期错误：src/router/transport.ts:403-408 apiKeyFor() 未设即返 null，
# 不发 authorization 头 → 请求失败 → 计入熔断窗口 → 该 endpoint 被 open。
# 后果：tier1 是当前唯一能承载 primary 轨的端点（其余 primary 端点 enabled:false、
#       tier2 只挂 light），它一挂，所有交互式任务（dotd ask / 飞书消息）全部挂起。

# tier1 primary 端点 openrouter-main（config/models.yml）：
#   base_url http://127.0.0.1:7863/v1，模型 hy3，2026-10-16 主人指定走本机
#   workbuddy2api 代理（0.0.0.0:7863 → 容器，4 账号池）。
# 拿法：该容器 /app/config.json 里的 api_key（wb2a… 37 位）：
#   docker exec workbuddy2api cat /app/config.json | grep api_key
#   ⚠️ 完整搭建步骤、账号登录、以及没有这个容器时怎么换端点，
#      见 docs/tier1-endpoint.md（本文只列变量，不重复步骤）。
#   ⚠️ 与 tokens.env 里旧的 HY3_API_KEY 不是同一个值，别混用（models.yml 注明）。
#   ⚠️ 本机实况：这个 key 目前不在 tokens.env 也不在 Windows 环境变量里，
#      只在跑着的 daemon 进程环境中——重启会丢，详见 docs/tier1-endpoint.md §4。
WB2API_KEY=__REPLACE_WITH_WORKBUDDY2API_KEY__

# tier2 备胎 openrouter-fallback（config/models.yml:37-47，当前 enabled:false）。
# 主人把 enabled 改回 true 才需要；启用即热加载生效。
# 拿法：https://openrouter.ai/keys（注意免费路由在本机实测 ~40% 返回 200 无 choices）。
OPENROUTER_API_KEY=__OPTIONAL_OPENROUTER_KEY__

# tier1 备胎 backup-openai-compatible（config/models.yml:49-55，enabled:false）。
# 占位端点，启用前先改 base_url / models（现在写的是 example.com）。
BACKUP_API_KEY=__OPTIONAL_BACKUP_KEY__

# ── C. 可选通道与运维覆盖 ──────────────────────────────────────────

# Telegram：**已退役**（2026-10-16 主人拍板飞书机器人取代，且明确不要 Telegram）。
#   config/dotd.yml 里不再有 telegram: 节；TG_BOT_TOKEN 也没有代码读取，
#   配了不生效、不配不报错。留在这里只为说明"别再去 BotFather 申请"。
# TG_BOT_TOKEN=unconfigured

# 飞书通道（config/dotd.yml 的 feishu: 节六字段——仓库模板里就有这一节，
# 由 scripts/init-config.mjs 渲染进 ~/.dotd/config.yml，不用手写）。
# 六字段形状见 src/surfaces/config.ts:265-272 的 feishuSchema（app_id/app_secret/
# owner_chat_id/verification_token/encrypt_key/edit_throttle_ms）。
# 全部有 zod default 且 strict:false → 缺省不拒启动，但 appId/appSecret 任一为空
# 即装配 NULL_FEISHU_GATEWAY（available 恒 false，src/daemon.ts:694-697），
# 表现为"飞书那边一直没反应"且不报错。用 `npm run dotd -- sos-test` 查真实现状
# （GET /api/channels：逐通道可用性 + 投递顺序 + 最近 alert_dispatch 台账）。
# ⚠️ 下面这些 FEISHU_* 环境变量只有在 ~/.dotd/config.yml 里以 ${FEISHU_*} 占位符
#    出现时才被展开（src/surfaces/config.ts:204-211）；光 export 不写占位符没有任何效果。
# 拿法：飞书开放平台 → 企业自建应用 → 凭证与基础信息页。
# ⚠️ 入站走出站长连接（WSClient），不需要公网 URL、也不需要 verification token
#    （鉴权由 app_id/app_secret 握手完成，src/surfaces/feishu-ws.ts:1-10）；
#    verification_token/encrypt_key 是 HTTP webhook（/hooks/feishu）路径才用得上。
FEISHU_APP_ID=__OPTIONAL_FEISHU_APP_ID__
FEISHU_APP_SECRET=__OPTIONAL_FEISHU_APP_SECRET__
FEISHU_VERIFICATION_TOKEN=__OPTIONAL_FEISHU_VERIFICATION_TOKEN__
FEISHU_ENCRYPT_KEY=__OPTIONAL_FEISHU_ENCRYPT_KEY__
# allowlist 语义：只有 text 且会话 == owner_chat_id 才建任务；留空 = 一切入站 403 拒
# （fail-closed，src/surfaces/feishu-inbound.ts:131-134）。支持逗号分隔多会话。
# oc_ 开头；群 id 可在飞书群设置里拿，或用机器人把消息打进群后看 inbound 日志。
FEISHU_OWNER_CHAT_ID=__OPTIONAL_oc_CHAT_ID__

# CLI 侧（src/surfaces/cli.ts）：
#   base URL 三顺位 --url > DOTD_URL > 127.0.0.1:7788（:47-56）
# ⚠️ 契约 H2 的唯一监听端口是 7788，CLI 默认值也是它。~/.dotd/config.yml 的
#    surfaces.http.port 写成别的端口 = 制造漂移：daemon 起得来（只告警），
#    但不带 --url/DOTD_URL 的 CLI 与 Web UI 全部连不上（2026-10-17 实测踩过）。
DOTD_URL=http://127.0.0.1:7788
#   `dotd hook <source>` 自算 HMAC 时按 source 名查 env：
#   DOTD_HOOK_SECRET_<SOURCE 大写、非字母数字转 _>（:336-341）。
#   例：dotd hook grafana → 读 DOTD_HOOK_SECRET_GRAFANA（值须与 config.yml 里
#   grafana 的 secret 一致，即上面的 HOOK_GRAFANA）。
#   ⚠️ daemon 侧只登记 config/dotd.yml:56-60 里出现的 source（当前只有 grafana）；
#      `dotd hook smoke` 即便配了 DOTD_HOOK_SECRET_SMOKE 也会被 401「未登记的
#      hook source」拒（src/surfaces/http.ts:788-792）——本文件不登记它，要用
#      smoke 源请自己在 ~/.dotd/config.yml 的 hooks: 里加一项。
DOTD_HOOK_SECRET_GRAFANA=__SAME_AS_HOOK_GRAFANA__

# 路径 / 行为覆盖（全部有默认值，只在调试或多实例时设）：
#   数据目录根（src/daemon.ts:113-118；缺省 ~/.dotd）
DOTD_HOME=~/.dotd
#   surfaces 配置文件路径（src/surfaces/config.ts:354；缺省 ~/.dotd/config.yml）
DOTD_CONFIG=~/.dotd/config.yml
#   模块配置目录（src/daemon.ts:121-125；缺省 <repo>/config）
DOTD_CONFIG_DIR=
#   Web UI 静态根（src/daemon.ts:127-132；缺省 <repo>/web-ui/dist，缺失不拒启动只 404）
DOTD_WEB_ROOT=
#   SQLite 库路径（db/conn.ts:24-29；优先级 显式参数 > 本变量 > ~/.dotd/dotd.db）
DOTD_DB_PATH=
#   内存水位预留 MB（src/daemon.ts:193-198；优先于 ~/.dotd/config.yml 顶层 dotdReserveMb）
DOTD_RESERVE_MB=
#   背压基线钉死 MB（src/control-plane/guard.ts:77-80；跳过 30min 标定，运维用）
DOTD_GUARD_BASE_MB=

# tier2（Colibrì/OLMoE）通路：daemon 跑在 WSL，引擎只绑 Windows 127.0.0.1:8001，
#   要经 WSL 默认网关 + Windows 侧 win-relay（0.0.0.0:18001）才够得着。
#   ⚠️ 这个值**易失**：WSL 重启后默认网关 IP 会变，旧值让 tier2 整条断。
#      `scripts/setup-dev-env.sh` 每次跑都重算它（config/models.yml 里也有默认值兜底）。
#   拿法：在 WSL 里 `ip route show default | awk '{print $3}'`，拼成 http://<网关IP>:18001。
DOTD_TIER2_HOST=http://172.x.x.x:18001

# 执行面（真实 Docker 路径；见 scripts/wsl-fleet-boot.mts 的用法）：
#   fleet 后端：stub = 内存假容器（不起 Docker）；docker = dockerode 真实路径
#   （src/exec/types.ts:184-194）。
#   ⚠️ 缺省 = stub，不是真实路径：src/exec/types.ts:149-150 的
#      DEFAULT_EXEC_CONFIG.fleet='stub'，execConfigFromEnv 只对精确等于
#      'stub'/'docker' 的值做覆盖，拼错（Docker/DOCKER/real）也静默回落 stub
#      （:188-189）。要真实容器必须显式 DOTD_FLEET=docker。
#      （CONVENTIONS.md:157 的「非 stub 或缺省 = 真实路径」对 DOTD_FLEET 与代码不符。）
#   ⚠️ 真实路径要求 daemon 跑在 WSL 内：dockerSocketPath 硬编码 /var/run/docker.sock
#      （src/exec/types.ts:154），Windows 原生 node 到不了。
DOTD_FLEET=stub
DOTD_DOCKER_SOCKET=/var/run/docker.sock
#   镜像构建上下文根（src/exec/types.ts:192；WSL 部署指向 ~/dotd）
DOTD_REPO_ROOT=
#   容器 token 目录（src/daemon.ts:593；缺省 <dataDir>/exec-tokens）
DOTD_TOKEN_DIR=

# 模型 transport：stub = 内存回放、零网络请求（src/router/transport.ts:33-35）；
#   缺省 = 真实 HTTP。冒烟/CI 用它。
DOTD_MODEL_TRANSPORT=stub
#   stub 回放脚本（JSON 数组，按 endpointId×track 回放；src/router/transport.ts:756-775）
DOTD_MODEL_STUB_SCRIPT=

# /fs/ops 桥（src/memory/fsops-client.ts:74-78）：容器内 agent-runtime 的地址与 token。
#   stub fleet 下走 fsops-stub，不需要这两个。
DOTD_AGENT_RUNTIME_URL=
DOTD_AGENT_RUNTIME_TOKEN=

# 容器内 agent-runtime（agent-runtime/server.ts:837-838）：镜像里由 Dockerfile 设，
#   宿主侧不用管。
# PORT=9223
# DOTD_TOKEN_PATH=/run/dotd/token
# DOTD_STATE_DIR=/opt/agent-state

# ── D. 预留但当前无代码读取 ────────────────────────────────────────
# SMTP_URL：只在 src/surfaces/channels.ts:12,174-176 的注释里出现，作为阶段二
#   email 通道适配器的参数预留；当前没有任何代码读它，配了也不生效
#   （阶段一 email deliver 恒返回未实现）。
