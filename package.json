{
  "name": "dotd",
  "version": "0.1.0",
  "private": true,
  "description": "自主 Dot 系统（dotd）—— 常驻个人 AI Agent：TypeScript 单进程 daemon + SQLite + Playwright 容器",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dotd": "src/surfaces/cli.ts"
  },
  "scripts": {
    "dotd": "node --import tsx src/surfaces/cli.ts",
    "init-config": "node scripts/init-config.mjs",
    "doctor": "node scripts/doctor.mjs",
    "serve": "node --import tsx src/daemon.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:serial": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:fast": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "build:web": "npm --prefix web-ui run build",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.2",
    "dockerode": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
