# 依赖
node_modules/
.pnp.*
.yarn/

# 构建产物
dist/
*.tsbuildinfo
web-ui/dist/
web-ui/.vite/

# 运行期数据（唯一库文件 ~/.dotd/dotd.db 由 daemon 自己管，这里只挡误提交）
*.db
*.db-wal
*.db-shm
journal-blobs/

# 本地环境/密钥（绝不入库）
.env
.env.*
!.env.example
# scripts/init-config.mjs 的产物。正常落在 ~/.dotd/ 不受仓库管，但 DOTD_HOME
# 指到仓库内时它会带着三个随机密钥落在这里，一并挡掉。
/tokens.env

# 编辑/OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 日志
*.log
npm-debug.log*
OUTBOX.md

# ── 一次性探针 / 临时调试脚本（2026-10-17 追加，上面规则一条未动）──────────
# 这些是开发期的临时探针（写死内网 IP、WSL 绝对路径 /root/.dotd、任务 ID、
# systemd unit 全文等运维细节），不属于项目源码，不入库。
# 命名约定：以后新写的探针用 .tmp-*（任意目录）或 scripts/tmp-*，即自动被挡住。
/tmp-feishu-chats.sh
.tmp-*
scripts/tmp-*

# Windows 保留设备名误建文件（cmd 重定向 `> nul` 的产物，git add 会直接报错）
/nul
/nul.*

# ZCode 会话数据（可视化产物等，非项目源码）。原先只靠 .zcode/ 内嵌 .gitignore
# 的 `*` 挡着，那是脆的；这里补根级规则。
/.zcode/
# soak.jsonl 是**运行中持续追加**的数据（WSL 上 cron 每 30 分钟写一条）。
# 若把它纳入版本控制，每次'从 D: 同步到 WSL'都会用旧副本覆盖正在增长的文件，
# 导致采样丢失 + 出现无身份的历史混合样本（2026-10-19 实际踩到）。
docs/acceptance/soak.jsonl
docs/acceptance/soak-stress.jsonl
# soak-heartbeat.log 记录**每次 sample 运行的结局**（start/ok/skip probe-running/
# skip same-second/dead daemon）。没有它，soak.jsonl 里"没记录"无法区分
# "cron 没跑"和"脚本被我改坏了"—— 2026-10-20 实测丢过一次（03:30:01）。
docs/acceptance/soak-heartbeat.log
# acceptance.sh 每次运行会把上一轮结果归档成带时间戳的文件。
# 那是执行痕迹、不是交付物，不该进版本库堆着；需要追溯时留在 WSL 上即可。
docs/acceptance/results.*.jsonl
# soak-day0.txt 是 7 天窗口的**计时基准**，同样是运行中状态，不该进版本控制。
# 2026-10-20 实际查到：它被 git 跟踪，而 D: 侧是旧值（10-19 20:53 1792414394）、
# WSL 侧是新值（10-20 03:25 1792437920），**差 392 分钟**。
# 后果：任何一次 D:→WSL 同步都会把窗口起点往前拨 6.5 小时，
# 判据随之虚报"已经跑了 407 分钟"，而实际只跑了 15 分钟 ——
# 足以让 7 天窗口提前 6.5 小时判定"达标"。这是能让 S6 作弊的缝。
docs/acceptance/soak-day0.txt
